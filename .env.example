DATABASE_URL=postgres://gametracker:gametracker@localhost:5432/gametracker
PORT=3001
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=

# Number of proxies in front of the API whose X-Forwarded-For can be trusted.
# Leave empty locally. Login and sign-up limits count attempts per client IP,
# so behind a proxy without this every visitor shares one limit.
TRUST_PROXY=

# Twitch application used only to obtain an IGDB token.
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional. Fills Metacritic once per game when the page is opened.
# https://rawg.io/apidocs
RAWG_API_KEY=
